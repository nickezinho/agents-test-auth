# Configurações Gerais
PROJECT_NAME="Laboratório de Autenticação Multi-Agent"
ENVIRONMENT=development
DEBUG=True

# Banco de Dados PostgreSQL
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_local_123
POSTGRES_DB=auth_lab_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_local_123@db:5432/auth_lab_db

# Para execução local sem Docker (banco local ou sqlite de teste):
# DATABASE_URL=sqlite+aiosqlite:///./test_auth.db

# JWT e Criptografia
JWT_SECRET_KEY=super_secret_jwt_key_should_be_at_least_32_bytes_long_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuração de Cookies
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/v1/auth

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
